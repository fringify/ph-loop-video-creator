{
  "name": "ph-loop-video-creator",
  "version": "1.0.0",
  "private": true,
  "description": "Turn your motorcycle road-trip photos and notes into an animated map video.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "build": "tsx scripts/build.ts",
    "studio": "tsx scripts/check-data.ts && remotion studio src/index.ts",
    "sample": "tsx scripts/check-data.ts && remotion render src/index.ts Sample out/sample.mp4",
    "render": "tsx scripts/check-data.ts && remotion render src/index.ts Trip out/trip-video.mp4",
    "demo": "tsx scripts/make-demo.ts && tsx scripts/build.ts --trip examples/demo-trip",
    "typecheck": "tsc -p . && tsc -p tsconfig.scripts.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@remotion/cli": "4.0.535",
    "d3-geo": "^3.1.1",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.535",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
